# For local dev, copy this file to .env.local and adjust as needed.
#
# For production on Vercel: these must be set under Vercel's project
# Settings -> Environment Variables instead, pointing at the deployed
# MonsterASP API (e.g. https://your-app.monsterasp.net/api). Vite bakes
# env vars into the build at build time, so a .env file alone is not
# enough - Vercel needs its own copy of these values.
VITE_API_BASE_URL=https://localhost:7000/api
VITE_GOOGLE_CLIENT_ID=453802998362-9n22t0pu5mfvi19v02fc2noenalmjhvg.apps.googleusercontent.com
